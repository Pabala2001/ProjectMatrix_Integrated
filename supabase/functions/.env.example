# Paystack TEST configuration reference. Keep this committed template unfilled.
# For hosted functions, enter these four values in Supabase Edge Function Secrets.
# For local serving, copy to supabase/functions/.env and fill in that private copy.
PAYSTACK_ENVIRONMENT=test
PAYSTACK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_TEST_SECRET_KEY
PAYSTACK_CALLBACK_URL=https://projectmatrix.lemapeo.com/paystack-callback.html
PAYSTACK_ALLOWED_ORIGINS=https://projectmatrix.lemapeo.com,http://localhost:3000
# Add the exact browser preview origin if testing from Google AI Studio.
# Use comma-separated origins (scheme + host + optional port), no paths or wildcards.
# The callback file must be published at PAYSTACK_CALLBACK_URL before testing.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied
# by Supabase's function runtime. Do not overwrite them with placeholder values.
# Never put real server secrets in the frontend, this template, or GitHub.
