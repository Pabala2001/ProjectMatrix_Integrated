# Browser configuration: use the existing primary ProjectMatrix Supabase project.
# These must be the project's public URL and anon/publishable key.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY

# Local Express + Vite server. Production: npm run build && npm start.
APP_URL=http://localhost:3000
PORT=3000

# Optional server-side features. Leave empty to disable the related provider.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENWEATHER_API_KEY=

# Optional server overrides; otherwise the Express server uses the VITE values above.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY

# Paystack and Supabase service-role secrets belong in Supabase Edge Function secrets.
# See supabase/functions/.env.example. Never prefix server secrets with VITE_.
